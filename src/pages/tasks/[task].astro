---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { taskDisplayNames } from '../../lib/registry/labels';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return [...new Set(models.map((model) => model.data.task))].map((task) => ({ params: { task }, props: { task, models: models.filter((model) => model.data.task === task) } }));
}

const { task, models } = Astro.props as { task: CollectionEntry<'models'>['data']['task']; models: CollectionEntry<'models'>[] };
const taskLabel = taskDisplayNames[task] ?? task;
---
<SiteLayout title={`${taskLabel} 模型 · Web Model SDK`} description={`${taskLabel} 浏览器模型 SDK`}><h1>{taskLabel}</h1><ul>{models.map((entry) => <li><a href={`/models/${entry.id}/`}>{entry.data.name}</a> · {entry.data.status}</li>)}</ul></SiteLayout>
