---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import ModelDirectory from '../components/registry/ModelDirectory';
const models = (await getCollection('models')).map((entry) => entry.data);
---

<SiteLayout
  title="浏览器端模型 SDK 目录 | Web Model SDK"
  description="面向浏览器开发者的模型 SDK 目录，优先提供本地可用的集成信息。"
>
  <section class="intro" aria-labelledby="page-title">
    <h1 id="page-title">浏览器端模型 SDK 目录</h1>
    <p class="lede">从本地优先的角度整理可在浏览器中使用的模型 SDK，帮助开发者快速了解能力、运行约束与集成入口。</p>
  </section>
  <ModelDirectory models={models} client:load />
</SiteLayout>
